{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cosmic:space_altar_ambient",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.spawning = 1;variable.limit_spawn_time = 1.8;",
				"per_update_expression": "v.spawning = Math.max(0, Math.min(1, (variable.limit_spawn_time - variable.emitter_age + Math.abs(variable.limit_spawn_time - variable.emitter_age)) / Math.abs(variable.limit_spawn_time - variable.emitter_age + 1)));"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "100*variable.spawning",
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 13
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 5,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(5, 10)"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": "Math.random(-100, 100)"
			},
			"minecraft:particle_initial_speed": 0.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 1, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.04+variable.particle_random_2/5", "0.04+variable.particle_random_2/5"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [10, 88],
					"uv_size": [7, 9]
				}
			},
			"minecraft:particle_motion_collision": {
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.particle_random_3>0.2 ? 1 : 0.5", "variable.particle_random_3>0.2 ? 1 : 0.5", 1, 1]
			}
		}
	}
}